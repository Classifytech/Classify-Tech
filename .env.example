# ClassifyTech Environment Variable Template
# All environment variables are OPTIONAL. Built-in defaults are used if unset.
# Leave keys commented out so AI Studio Preview does not display prompt modals.

# Server Port (Optional: defaults to 3000)
# PORT=3000

# Node Environment (Optional: defaults to development)
# NODE_ENV=development

# Development Hot Module Reloading (Optional: set to 'true' only if explicitly disabling HMR)
# DISABLE_HMR=false

# Server Admin Security Key (Optional: set a strong PIN or password to enable Admin Console)
# ADMIN_SECRET=

# Public Site Domain (Optional: set your owned public domain, e.g. https://deals.yourdomain.com)
# PUBLIC_SITE_URL=
